<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Life App</title>
<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: sans-serif; background: #0f172a; color: #e2e8f0; height: 100vh; overflow: hidden; }
#lock { position: fixed; inset: 0; background: #0f172a; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; animation: fadeIn 0.8s ease; }
#lock input { padding: 14px; font-size: 18px; border-radius: 10px; border: none; width: 220px; text-align: center; margin-bottom: 12px; }
#lock button { padding: 12px 24px; font-size: 16px; border: none; border-radius: 10px; background: #2563eb; color: white; }
#lockMsg { color: #f87171; height: 20px; }
#app { display: none; height: 100vh; flex-direction: column; animation: fadeIn 0.6s ease; }
#content { flex: 1; overflow-y: auto; padding: 16px; }
h1 { font-size: 22px; text-align: center; }
#form { display: flex; gap: 8px; }
#input { flex: 1; padding: 12px; font-size: 16px; border: none; border-radius: 8px; }
.addBtn { padding: 12px 16px; font-size: 16px; border: none; border-radius: 8px; background: #2563eb; color: white; }
ul { list-style: none; padding: 0; margin-top: 16px; }
li { display: flex; align-items: center; gap: 10px; background: #1e293b; padding: 12px; margin-bottom: 8px; border-radius: 10px; animation: fadeIn 0.4s ease; }
li span { flex: 1; }
li.done span { text-decoration: line-through; color: #64748b; }
.del { background: #dc2626; border: none; color: white; padding: 6px 10px; border-radius: 6px; }
nav { display: flex; justify-content: space-around; background: #1e293b; padding: 8px 4px; }
.tab { background: none; border: none; color: #94a3b8; text-align: center; font-size: 12px; padding: 4px; transition: transform 0.3s; }
.tab.active { color: #60a5fa; transform: scale(1.1); }
.tab .name { display: block; margin-top: 4px; }
.pic { width: 36px; height: 36px; border-radius: 50%; background: #334155; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
<body>
<div id="lock">
  <h2>Enter password</h2>
  <input id="pw" type="password" placeholder="Password">
  <button id="unlock">Unlock</button>
  <div id="lockMsg"></div>
</div>
<div id="app">
  <div id="content"></div>
  <nav id="nav"></nav>
</div>
<script>
const PASSWORD = '1234';

const tabs = [
  { name: 'To-Do Lists', person: 'Shivaji Maharaj', icon: '🚩' },
  { name: 'Reminders', person: 'Zoro', icon: '⚔️' },
  { name: 'CFA Study Log', person: 'Warren Buffett', icon: '📈' },
  { name: 'Expenses', person: 'Jim Rogers', icon: '💰' },
  { name: 'AI', person: 'Lionel Messi', icon: '🤖' },
  { name: 'Progress', person: 'John Cena', icon: '🏆' }
];

let current = 0;
let tasks = {};

function unlock() {
  const val = document.getElementById('pw').value;
  if (val === PASSWORD) {
    document.getElementById('lock').style.display = 'none';
    document.getElementById('app').style.display = 'flex';
    buildNav();
    showTab(0);
  } else {
    document.getElementById('lockMsg').textContent = 'Wrong password';
  }
}

document.getElementById('unlock').onclick = unlock;
document.getElementById('pw').addEventListener('keydown', e => { if (e.key === 'Enter') unlock(); });

// Lock again when the app goes to the background
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    document.getElementById('app').style.display = 'none';
    document.getElementById('lock').style.display = 'flex';
    document.getElementById('pw').value = '';
    document.getElementById('lockMsg').textContent = '';
  }
});

function buildNav() {
  const nav = document.getElementById('nav');
  nav.innerHTML = '';
  tabs.forEach((t, i) => {
    const b = document.createElement('button');
    b.className = 'tab' + (i === current ? ' active' : '');
    b.innerHTML = '<span class="pic">' + t.icon + '</span><span class="name">' + t.name + '</span>';
    b.onclick = () => showTab(i);
    nav.appendChild(b);
  });
}

function showTab(i) {
  current = i;
  buildNav();
  const content = document.getElementById('content');
  if (i === 0) {
    renderTodo(content);
  } else {
    content.innerHTML = '<h1>' + tabs[i].name + '</h1><p style="text-align:center">Coming in the next version.</p>';
  }
}

function renderTodo(container) {
  const list = tasks.todo || [];
  container.innerHTML = '<h1>To-Do Lists</h1><form id="form"><input id="input" placeholder="Add a task..." autocomplete="off"><button class="addBtn" type="submit">Add</button></form><ul id="list"></ul>';
  const ul = document.getElementById('list');
  list.forEach((task, i) => {
    const li = document.createElement('li');
    if (task.done) li.classList.add('done');
    const check = document.createElement('input');
    check.type = 'checkbox';
    check.checked = task.done;
    check.onchange = () => { list[i].done = check.checked; tasks.todo = list; renderTodo(container); };
    const span = document.createElement('span');
    span.textContent = task.text;
    const del = document.createElement('button');
    del.className = 'del';
    del.textContent = 'X';
    del.onclick = () => { list.splice(i, 1); tasks.todo = list; renderTodo(container); };
    li.append(check, span, del);
    ul.appendChild(li);
  });
  document.getElementById('form').addEventListener('submit', e => {
    e.preventDefault();
    const input = document.getElementById('input');
    const v = input.value.trim();
    if (!v) return;
    list.push({ text: v, done: false });
    tasks.todo = list;
    renderTodo(container);
  });
}
</script>
</body>
</html>
